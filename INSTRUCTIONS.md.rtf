def build_image_generation_context(state: Dict[str, Any], step_id: str) -> Dict[str, Any]:\par
    previous_strategy_key = f"image_strategy_\{int(step_id) - 1\}"\par
    strategy = state.get(previous_strategy_key) or state.get("image_strategy")\par
    if not isinstance(strategy, dict):\par
        fail(\par
            "MISSING_IMAGE_STRATEGY",\par
            f"No image strategy found for image generation step \{step_id\}",\par
            field="image_strategy",\par
            expected=previous_strategy_key,\par
            actual=type(strategy).__name__,\par
        )\par
\par
    product_data = get_extraction_output(state, "01A")\par
    visual_data = get_extraction_output(state, "01B")\par
\par
    return \{\par
        "reference_tag": state.get("reference_tag", ""),\par
        "image_task": \{\par
            "image_number": int(step_id) // 2,\par
            "image_type": strategy.get("image_type", ""),\par
            "buyer_question": strategy.get("buyer_question", ""),\par
        \},\par
        "image_generation_prompt": strategy.get("image_generation_prompt", ""),\par
        "included_accessories": product_data.get("package_contents", []),\par
        "visual_grounding": \{\par
            "visual_identity": visual_data.get("visual_identity", \{\}),\par
            "object_layout_map": visual_data.get("object_layout_map", \{\}),\par
            "product_geometry": visual_data.get("product_geometry", \{\}),\par
            "image_views": visual_data.get("image_views", \{\}),\par
        \},\par
        "style_lock": state.get("image_style_lock", deterministic_style_lock()),\par
        "source_images": state.get("source_payload", \{\}).get("source_images", []),\par
    \}\par
\par
def build_model_context_for_step(state: Dict[str, Any], step_id: str) -> Dict[str, Any]:\par
    if step_id in IMAGE_PROMPT_STEP_IDS:\par
        return \{\par
            "context_type": "IMAGE_CONTEXT_JSON",\par
            "image_context": build_image_prompt_context(state, step_id),\par
        \}\par
    return state\par
\par
def build_text_input(state: Dict[str, Any], prompt_text: str) -> str:\par
    context_label = "IMAGE_CONTEXT_JSON" if state.get("context_type") == "IMAGE_CONTEXT_JSON" else "WORKFLOW_STATE_JSON"\par
    compact_state = json.dumps(state, ensure_ascii=False, indent=2)\par
    return (\par
        f"\{context_label\}:\\n\{compact_state\}\\n\\n"\par
        f"INSTRUCTIONS:\\n\{prompt_text\}\\n\\n"\par
        f"OUTPUT RULES:\\nReturn only valid JSON."\par
    )\par
